{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug STM32F411",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/stm32f411xe.elf",
      "gdbPath": "C:/Program Files (x86)/Arm/GNU Toolchain mingw-w64-i686-arm-none-eabi/bin/arm-none-eabi-gdb.exe",
      "device": "STM32F411VE",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f4x.cfg"
      ],
      "serverpath": "C:/openocd/xpack-openocd-0.12.0-7/bin/openocd.exe",
      "searchDir": [
        "C:/openocd/xpack-openocd-0.12.0-7/openocd/scripts"
      ],
      "svdFile": "",
      "runToEntryPoint": "main",
      "preLaunchTask": "Build STM32",
      "preLaunchCommands": [
        "set substitute-path /mnt/c c:/"
      ]
    }
  ]
}